# Copy this file to .env and fill in real values for your environment.
# Never commit a real .env file. See docs/SECURITY.md.

# --- General -----------------------------------------------------------
APP_ENV=local
APP_NAME=Loan Management System
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
APP_TIME_ZONE=Africa/Accra

DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database ------------------------------------------------------------
# Used by docker-compose to create the local Postgres container.
POSTGRES_DB=loan_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Used by the backend to connect. Host is the docker-compose service name.
DATABASE_URL=postgresql://postgres:postgres@db:5432/loan_management

# --- Cookies and security -------------------------------------------------
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Google OAuth (wired up in Stage 2) -----------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (wired up in Stage 2 / Stage 8) --------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@localhost
# CC'd on every signed-agreement email sent to the customer — an internal
# oversight mailbox, never hard-coded. Optional: leave blank to send to the
# customer only.
AGREEMENT_ACTION_EMAIL=
# Placeholder legal identity shown on the agreement PDF (Stage 8) — a real
# entity name is a production-launch task, not a code change.
LENDER_NAME=[Lender Legal Name Placeholder]

# --- Hubtel (wired up in Stage 11) ----------------------------------------
# Quick SMS API (smsc.hubtel.com) — clientid/clientsecret are sent as query
# params, not HTTP Basic Auth. Leave HUBTEL_BASE_URL blank to use the default.
HUBTEL_ENABLED=false
HUBTEL_BASE_URL=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=
HUBTEL_ADMIN_PHONE_E164=
HUBTEL_CONNECT_TIMEOUT_SECONDS=5
HUBTEL_READ_TIMEOUT_SECONDS=10
HUBTEL_MAX_REQUESTS_PER_MINUTE=60
SMS_DRY_RUN=true
SMS_MAX_ATTEMPTS=3
# Reminder times are set from the admin dashboard (/admin/settings), not here.

# --- Storage (local now; S3-compatible added when needed in production) --
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# --- Monitoring (wired up in Stage 14) ------------------------------------
SENTRY_DSN=

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
